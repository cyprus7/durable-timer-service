{
  "name": "durable-timer-service",
  "version": "0.1.0",
  "private": true,
  "description": "Durable one-shot timer delivery service backed by PostgreSQL.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "dev": "tsx src/main.ts",
    "test": "npm run build && node --test \"dist/test/**/*.unit.test.js\"",
    "check": "npm audit --omit=dev --audit-level=high && npm test",
    "e2e:up": "docker compose -f compose.e2e.yml up -d --wait",
    "e2e:down": "docker compose -f compose.e2e.yml down -v",
    "test:e2e": "npm run build && node --test \"dist/test/**/*.e2e.test.js\""
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
