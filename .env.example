PORT=8080
DATABASE_URL=postgres://timer:timer@localhost:5432/timer_service
TIMER_TARGETS={"example-worker":"http://worker:3000/timers/callback"}
TIMER_LANES=realtime
API_TOKEN=replace-with-a-long-random-secret
# Use mounted certificates, or explicitly enable ALLOW_INSECURE_HTTP=true only
# behind a trusted TLS terminator / on an isolated trusted network.
TLS_CERT_FILE=/run/timer-tls/tls.crt
TLS_KEY_FILE=/run/timer-tls/tls.key
ALLOW_INSECURE_HTTP=false
# Optional shared credential checked by your callback consumers:
# TIMER_CALLBACK_SECRET=replace-with-a-separate-secret
MAX_TIMER_STORAGE_BYTES=10737418240
MAX_SCHEDULES_PER_MINUTE=60000
MAX_TIMERS_PER_SESSION=100000
MAX_CANCEL_SESSION_TIMERS=100000
MAX_CONCURRENT_REQUESTS=256
WORKER_ENABLED=true
CLAIM_BATCH_SIZE=25
LEASE_MS=20000
POLL_INTERVAL_MS=250
CLEANUP_INTERVAL_MS=60000
HTTP_CLIENT_TIMEOUT_MS=5000
MAX_CALLBACK_RESPONSE_BYTES=65536
RETRY_BASE_MS=1000
RETRY_MAX_MS=60000
